{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix cloudcompare-frontend",
  "buildCommand": "npm run build --prefix cloudcompare-frontend",
  "outputDirectory": "cloudcompare-frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cloudcompare-ai-api.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*/",
      "destination": "https://cloudcompare-ai-api.onrender.com/api/:path*/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
